<!DOCTYPE html>
<html>
<head>
  <title>Wanted Users</title>
  <style>
    body {
      font-family: Arial;
      text-align: center;
    }
    h1 {
      color: pink;
    }
    table {
      margin: auto;
      border-spacing: 20px;
    }
  </style>
</head>
<body>

<h1>WANTED USERS</h1>

<table id="userTable">
  <tr>
    <th>Name</th>
    <th>Email</th>
  </tr>
</table>

<script>
fetch('https://jsonplaceholder.typicode.com/users')
  .then(response => response.json())
  .then(data => {
    const table = document.getElementById('userTable');

    data.forEach(user => {
      let row = table.insertRow();
      row.insertCell(0).innerText = user.name;
      row.insertCell(1).innerText = user.email;
    });
  })
  .catch(error => console.log(error));
</script>

</body>
</html>
